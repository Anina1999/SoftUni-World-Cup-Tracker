// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  matches Match[]
  likes   Match[] @relation("MatchLikes")

  @@map("users")
}

model Match {
  id          String   @id @default(cuid())
  homeTeam    String
  awayTeam    String
  homeGoals   Int
  awayGoals   Int
  stage       String
  venue       String
  date        String
  imageUrl    String
  description String
  userId      String
  createdAt   DateTime @default(now())

  owner   User   @relation(fields: [userId], references: [id])
  likedBy User[] @relation("MatchLikes")

  @@map("matches")
}
