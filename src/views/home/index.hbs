<main class="home">
  <section id="home">
    <h1>World Cup<br>2026</h1>
    <h2>Follow every match, track scores and add your own match reports from the greatest football tournament on Earth.
    </h2>
  </section>

  <section id="last-added">
    {{#each matches}}
     <div>
      <img src="{{imageUrl}}" alt="Match">
      <div id="text-content">
        <p>{{homeTeam}} vs {{awayTeam}}</p>
        <p>{{homeGoals}} - {{awayGoals}} &nbsp;|&nbsp; {{stage}}</p>
      </div>
      <a class="details-btn" href="/match/{{id}}/details">Details</a>
    </div>
    {{else}}
    <p class="no-post">There are no matches yet!</p>
    {{/each}}
  </section>
</main>