<main class="create">
  <section id="create">
    <div class="form">
      <h2>⚽ Add Match</h2>
      <form class="create-form" method="POST">
        <label>Home Team</label>
        <input type="text" id="home-team" name="homeTeam" placeholder="e.g. Brazil" />
        <label>Away Team</label>
        <input type="text" id="away-team" name="awayTeam" placeholder="e.g. Argentina" />
        <label>Home Goals</label>
        <input type="number" id="home-goals" name="homeGoals" placeholder="0" min="0" />
        <label>Away Goals</label>
        <input type="number" id="away-goals" name="awayGoals" placeholder="0" min="0" />
        <label>Stage</label>
        <select id="stage" name="stage">
          <option value="">Select stage...</option>
          <option>Group Stage</option>
          <option>Round of 16</option>
          <option>Quarter-final</option>
          <option>Semi-final</option>
          <option>Final</option>
        </select>
        <label>Venue</label>
        <input type="text" id="venue" name="venue" placeholder="e.g. MetLife Stadium, New York" />
        <label>Match Date</label>
        <input type="text" id="date" name="date" placeholder="DD/MM/YYYY" />
        <label>Image URL</label>
        <input type="text" id="obs-img" name="imageUrl" placeholder="https://..." />
        <label>Match Report</label>
        <textarea id="description" name="description" placeholder="Describe the match..."></textarea>
        <button type="submit">Add Match</button>
      </form>
    </div>
  </section>
</main>