<main class="details">
  <section id="details">
    <div id="details-wrapper">
      <p id="details-title">{{match.homeTeam}} vs {{match.awayTeam}}</p>
      <div id="img-wrapper">
        <img src="/images/match1.webp" alt="Match" />
      </div>
      <div id="info-wrapper">
        <table>
          <tr>
            <td>
              <p><strong>Home Team</strong><span id="details-home-team">{{match.homeTeam}}</span></p>
            </td>
            <td>
              <p><strong>Score</strong><span id="details-score">{{match.homeGoals}} - {{match.awayGoals}}</span></p>
            </td>
            <td>
              <p><strong>Away Team</strong><span id="details-away-team">{{match.awayTeam}}</span></p>
            </td>
          </tr>
          <tr>
            <td>
              <p><strong>Stage</strong><span id="details-stage">{{match.stage}}</span></p>
            </td>
            <td>
              <p><strong>Venue</strong><span id="details-venue">{{match.venue}}</span></p>
            </td>
            <td>
              <p><strong>Date</strong><span id="details-date">{{match.date}}</span></p>
            </td>
          </tr>
        </table>
        <p>
          <strong>Match Report</strong>
          <span id="details-description">{{match.description}}</span>
        </p>
      </div>
      <div id="action-buttons">
        {{#if user}}
          {{#if isOwner}}
          <a href="#" id="edit-btn">✏️ Edit</a>
          <a href="/match/{{match.id}}/delete" id="delete-btn">🗑️ Delete</a>
          {{else if hasLiked}}
          <p id="already-liked">⭐ You already liked this match!</p>
          {{else}}
          <a href="/match/{{match.id}}/like" id="like-btn">⭐ Like</a>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </section>
</main>